<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="grafico_ordens" pageWidth="595" pageHeight="842" whenNoDataType="NoPages" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1b175830-287b-4320-becb-342d611a4bde">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQLLocal"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
            DATE_FORMAT(o.agenda, '%m/%Y') AS mes,
            COUNT(o.id) AS total_ordens,
            SUM(o.total) AS valor_total
        FROM ordem_servico o
        WHERE o.e_status = 'FECHADA'
        GROUP BY DATE_FORMAT(o.agenda, '%m/%Y')
        ORDER BY MAX(o.agenda) DESC;]]>
	</queryString>
	<field name="mes" class="java.lang.String"/>
	<field name="total_ordens" class="java.lang.Long"/>
	<field name="valor_total" class="java.math.BigDecimal"/>
