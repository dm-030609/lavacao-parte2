<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ifsc.fln.controller.FXMLAnchorPaneCadastroVeiculoController"
            prefHeight="600.0" prefWidth="800.0">
    <children>
        <SplitPane dividerPositions="0.4"
                   AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <items>

                <!-- Lado esquerdo - Tabela -->
                <AnchorPane>
                    <children>
                        <TableView fx:id="tableViewVeiculos"
                                   AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                            <columns>
                                <TableColumn fx:id="tableColumnVeiculos" text="Veículos" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </AnchorPane>

                <!-- Lado direito - Detalhes -->
                <AnchorPane>
                    <children>
                        <VBox spacing="20.0" alignment="TOP_CENTER"
                              AnchorPane.topAnchor="20.0" AnchorPane.bottomAnchor="20.0"
                              AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">

                            <!-- Detalhes do Veículo -->
                            <VBox spacing="10.0">
                                <Label text="Detalhes do Veículo">
                                    <font><Font name="System Bold" size="14.0"/></font>
                                </Label>
                                <GridPane hgap="10" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="100.0"/>
                                        <ColumnConstraints minWidth="200.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="30.0"/>
                                        <RowConstraints minHeight="30.0"/>
                                        <RowConstraints minHeight="30.0"/>
                                        <RowConstraints minHeight="30.0"/>
                                        <RowConstraints minHeight="30.0"/>
                                    </rowConstraints>
                                    <children>
                                        <Label text="ID:" GridPane.rowIndex="0"/>
                                        <Label fx:id="tfVeiculoId" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                        <Label text="Placa:" GridPane.rowIndex="1"/>
                                        <Label fx:id="tfVeiculoPlaca" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                        <Label text="Observações:" GridPane.rowIndex="2"/>
                                        <Label fx:id="tfVeiculoObservacoes" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                        <Label text="Cor:" GridPane.rowIndex="3"/>
                                        <Label fx:id="tfVeiculoCor" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                        <Label text="Proprietário:" GridPane.rowIndex="4"/>
                                        <Label fx:id="tfVeiculoProprietario" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                    </children>
                                </GridPane>
                            </VBox>

                            <!-- Modelo -->
                            <VBox spacing="10.0">
                                <Label text="Modelo">
                                    <font><Font name="System Bold" size="14.0"/></font>
                                </Label>
                                <GridPane hgap="10" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="100.0"/>
                                        <ColumnConstraints minWidth="200.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="30.0"/>
                                        <RowConstraints minHeight="30.0"/>
                                    </rowConstraints>
                                    <children>
                                        <Label text="Nome:" GridPane.rowIndex="0"/>
                                        <Label fx:id="tfVeiculoModeloDescricao" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                        <Label text="Categoria:" GridPane.rowIndex="1"/>
                                        <Label fx:id="tfVeiculoModeloCategoria" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    </children>
                                </GridPane>
                            </VBox>

                            <!-- Motor -->
                            <VBox spacing="10.0">
                                <Label text="Motor">
                                    <font><Font name="System Bold" size="14.0"/></font>
                                </Label>
                                <GridPane hgap="10" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="100.0"/>
                                        <ColumnConstraints minWidth="200.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="30.0"/>
                                        <RowConstraints minHeight="30.0"/>
                                    </rowConstraints>
                                    <children>
                                        <Label text="Potência:" GridPane.rowIndex="0"/>
                                        <Label fx:id="tfVeiculoModeloMotorPotencia" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                        <Label text="Tipo Combustível:" GridPane.rowIndex="1"/>
                                        <Label fx:id="tfVeiculoModeloMotorTipoCombustivel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    </children>
                                </GridPane>
                            </VBox>

                            <!-- Botões -->
                            <HBox spacing="15.0" alignment="CENTER">
                                <Button fx:id="btInserir" text="Inserir" onAction="#handleBtInserir"/>
                                <Button fx:id="btAlterar" text="Alterar" onAction="#handleBtAlterar"/>
                                <Button fx:id="btExcluir" text="Excluir" onAction="#handleBtExcluir"/>
                            </HBox>

                        </VBox>
                    </children>
                </AnchorPane>

            </items>
        </SplitPane>
    </children>
</AnchorPane>
